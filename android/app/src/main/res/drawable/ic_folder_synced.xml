        android:pathData="M1.5,5.2C1.5,4.3 2.3,3.5 3.2,3.5h4.4c0.5,0 1,0.2 1.4,0.6l1.5,1.6h10.3c0.9,0 1.7,0.8 1.7,1.7v9.1c0,1 -0.8,1.7 -1.7,1.7H3.2c-0.9,0 -1.7,-0.7 -1.7,-1.6V5.2z" />

    <!-- badge disc, centred in the lower right and inside the viewport -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M17.6,15.4m-5.4,0a5.4,5.4 0 1,0 10.8,0a5.4,5.4 0 1,0 -10.8,0" />

    <!-- two stacked arrows: top points right, bottom points left -->
