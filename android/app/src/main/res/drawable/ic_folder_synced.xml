        android:pathData="M14.2,14.2h4.1v-1.0l1.7,1.7l-1.7,1.7v-1.0h-4.1c-0.6,0 -1.1,0.4 -1.2,1.0h-0.9C12.1,15.2 13.0,14.2 14.2,14.2z" />
    <path android:fillColor="#0A84FF"
        android:pathData="M21.0,16.6h-4.1v1.0l-1.7,-1.7l1.7,-1.7v1.0h4.1c0.6,0 1.1,-0.4 1.2,-1.0h0.9C23.1,15.6 22.2,16.6 21.0,16.6z" />
</vector>
