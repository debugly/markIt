<?xml version="1.0" encoding="utf-8"?>
<!-- Folder carrying a white badge with a sync glyph, so a folder that has
     WebDAV sync configured is distinguishable from an ordinary one at list-row
     size. The glyph is deliberately chunky: at 28dp a thin stroke turns to
     noise, and it is kept well inside the 24dp viewport so nothing is clipped
     by the badge edge. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">

    <!-- folder body -->
