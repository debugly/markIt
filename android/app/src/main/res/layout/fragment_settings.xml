<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas">

    <LinearLayout
        android:id="@+id/settingsBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_canvas"
        android:paddingStart="6dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/settingsBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="设置"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/fg_default" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/settingsBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Appearance -->
            <TextView
                style="@style/SettingsSection"
                android:text="外观" />

            <include
                android:id="@+id/themeRow"
                layout="@layout/item_setting_spinner" />

            <include
                android:id="@+id/styleRow"
                layout="@layout/item_setting_spinner" />

            <!-- Sync -->
            <TextView
                style="@style/SettingsSection"
                android:text="同步" />

            <TextView
                android:id="@+id/clearRecent"
                style="@style/SettingsAction"
                android:text="清除最近打开" />

            <TextView
                style="@style/SettingsHint"
                android:paddingTop="0dp"
                android:paddingBottom="12dp"
                android:text="文件 Tab 的「最近打开」分区将清空" />

            <!-- Vault -->
            <TextView
                style="@style/SettingsSection"
                android:text="文件夹" />

            <TextView
                android:id="@+id/changeVault"
                style="@style/SettingsAction"
                android:text="更换 MarkIt 文件夹" />

            <TextView
                android:id="@+id/vaultPath"
                style="@style/SettingsHint"
                android:paddingBottom="12dp" />

            <!-- About -->
            <TextView
                style="@style/SettingsSection"
                android:text="关于" />

            <!-- Shows the version, and reports up to date when tapped. Talking
                 to a release feed is separate work; the row is in place so the
                 answer lands where the user asked for it. -->
            <TextView
                android:id="@+id/checkUpdate"
                style="@style/SettingsAction"
                android:text="检查更新" />

            <TextView
                android:id="@+id/versionText"
                style="@style/SettingsHint"
                android:paddingBottom="8dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>