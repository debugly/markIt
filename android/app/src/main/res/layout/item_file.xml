<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="11dp"
    android:paddingBottom="11dp"
    android:background="?android:attr/selectableItemBackground">

    <ImageView
        android:id="@+id/fileIcon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:padding="1dp"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="11dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/fileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/fg_default"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/fileMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/fg_muted"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/syncBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="同步"
        android:textSize="11sp"
        android:textColor="@color/accent"
        android:background="@color/accent_soft"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone" />

    <!-- Shown when the note has local edits the server has not received. -->
    <ImageView
        android:id="@+id/pendingSync"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_sync_pending"
        android:contentDescription="@string/pending_sync_description"
        android:visibility="gone" />

    <TextView
        android:id="@+id/chevron"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textSize="20sp"
        android:textColor="@color/fg_muted"
        android:layout_marginStart="6dp" />

</LinearLayout>
