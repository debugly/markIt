<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F2F7">

    <!-- Own toolbar: the file list's search bar and FAB are hidden on this
         screen, and the title needs a way back to the vault. -->
    <LinearLayout
        android:id="@+id/syncTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingStart="6dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/syncBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回" />

        <TextView
            android:id="@+id/syncTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="同步"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#111111" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/syncScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="WebDAV 服务器" android:textSize="12sp" android:textColor="#8A8A8E" />

            <EditText android:id="@+id/davUrl" android:layout_width="match_parent"
                android:layout_height="46dp" android:layout_marginTop="9dp"
                android:background="@drawable/bg_search" android:paddingStart="12dp"
                android:paddingEnd="12dp" android:textSize="14sp"
                android:hint="https://dav.nas.local:5006/" android:inputType="textUri"
                android:importantForAutofill="no" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="用户名" android:textSize="12sp" android:textColor="#8A8A8E"
                android:layout_marginTop="12dp" />

            <EditText android:id="@+id/davUser" android:layout_width="match_parent"
                android:layout_height="46dp" android:layout_marginTop="7dp"
                android:background="@drawable/bg_search" android:paddingStart="12dp"
                android:paddingEnd="12dp" android:textSize="14sp"
                android:inputType="text" android:importantForAutofill="no" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="密码" android:textSize="12sp" android:textColor="#8A8A8E"
                android:layout_marginTop="12dp" />

            <EditText android:id="@+id/davPass" android:layout_width="match_parent"
                android:layout_height="46dp" android:layout_marginTop="7dp"
                android:background="@drawable/bg_search" android:paddingStart="12dp"
                android:paddingEnd="12dp" android:textSize="14sp"
                android:inputType="textPassword" android:importantForAutofill="no" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="远程路径" android:textSize="12sp" android:textColor="#8A8A8E"
                android:layout_marginTop="12dp" />

            <EditText android:id="@+id/davPath" android:layout_width="match_parent"
                android:layout_height="46dp" android:layout_marginTop="7dp"
                android:background="@drawable/bg_search" android:paddingStart="12dp"
                android:paddingEnd="12dp" android:textSize="14sp"
                android:hint="MarkIt" android:inputType="text"
                android:importantForAutofill="no" />

            <TextView android:id="@+id/btnTest" android:layout_width="match_parent"
                android:layout_height="46dp" android:layout_marginTop="18dp"
                android:background="@drawable/bg_search" android:gravity="center"
                android:text="测试连接" android:textSize="15sp" android:textStyle="bold"
                android:textColor="#0A84FF" />
        </LinearLayout>

        <TextView android:id="@+id/syncStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp" android:textSize="12sp" android:textColor="#8A8A8E"
            android:text="此文件夹未设置同步" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="14dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="保存后自动同步" android:textSize="15sp" android:textColor="#1C1C1E" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="停止编辑 3 秒后自动上传"
                    android:textSize="12sp" android:textColor="#8A8A8E" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/swAutoSync"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView android:id="@+id/btnSyncNow" android:layout_width="match_parent"
            android:layout_height="48dp" android:background="@drawable/bg_search"
            android:gravity="center" android:text="立即同步"
            android:textSize="15sp" android:textStyle="bold" android:textColor="#34C759" />

        <TextView android:id="@+id/btnRemoveSync" android:layout_width="match_parent"
            android:layout_height="46dp" android:layout_marginTop="10dp"
            android:background="@drawable/bg_search" android:gravity="center"
            android:text="停止同步此文件夹" android:textSize="14sp"
            android:textColor="#FF3B30" android:visibility="gone" />

    </LinearLayout>
    </ScrollView>
</LinearLayout>
