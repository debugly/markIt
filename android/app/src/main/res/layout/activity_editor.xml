<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_canvas"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/fg_default"
            android:maxLines="1"
            android:ellipsize="middle"
            android:layout_marginStart="4dp" />

        <ImageButton
            android:id="@+id/btnToggleMode"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_preview"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="切换预览" />

        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_more_vert"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="更多" />
    </LinearLayout>

    <EditText
        android:id="@+id/editorText"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_editor"
        android:gravity="top|start"
        android:padding="14dp"
        android:textSize="14sp"
        android:textColor="@color/fg_on_editor"
        android:fontFamily="monospace"
        android:inputType="textMultiLine|textNoSuggestions"
        android:importantForAutofill="no"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/statusBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <WebView
        android:id="@+id/previewWeb"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/bg_canvas"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/statusBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/statusBar"
        android:layout_width="0dp"
        android:layout_height="26dp"
        android:background="@color/bg_subtle"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textSize="11sp"
        android:textColor="@color/fg_muted"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
