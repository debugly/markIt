<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_canvas"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/fg_default"
            android:maxLines="1"
            android:ellipsize="middle"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />

        <ImageButton
            android:id="@+id/btnBold"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_format_bold"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="加粗" />

        <ImageButton
            android:id="@+id/btnItalic"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_format_italic"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="斜体" />

        <ImageButton
            android:id="@+id/btnHeading"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_format_heading"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="标题" />

        <ImageButton
            android:id="@+id/btnList"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_format_list"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="列表" />

        <ImageButton
            android:id="@+id/btnSource"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_code"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="切换到源码" />

        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_more_vert"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="更多" />
    </LinearLayout>

    <WebView
        android:id="@+id/editorWeb"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/statusBar"
        app:layout_constraintHeight_default="spread" />

    <TextView
        android:id="@+id/statusBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="26dp"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@color/bg_inset"
        android:textSize="12sp"
        android:textColor="@color/fg_muted"
        android:text="正在加载编辑器…"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
